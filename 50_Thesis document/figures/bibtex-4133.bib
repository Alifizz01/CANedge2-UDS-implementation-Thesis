@thesis{Can2023,
  author    = {Can, Adnan Furkan},
  title     = {Investigation of the aging of lithium-ion batteries},
  publisher      = {Technische Hochschule Ingolstadt},
  address   = {Ingolstadt},
  url       = {http://nbn-resolving.de/urn:nbn:de:bvb:573-41337},
  pages     = {58},
  school      = {Technische Hochschule Ingolstadt},
  year      = {2023},
  abstract  = {Everyday popularity of electric vehicles (EVs) is increasing among many manufacturers. Governments see EVs as a way to reduce oil dependency on carbon emissions and a step to solve the problem of climate change. Due to these feasible benefits of EVs, governments are funding EV technology. With this publicity, it is easy to predict that EVs could change the market soon. This leads to a new competition for manufacturers with the source of their power, "Batteries." In Electric Vehicles (EVs), Lithium-ion batteries are the dominant technology due to advantages such as long lifespan, high energy density, high open circuit voltage, and low self-discharge property. Despite recent advances in lithium-ion battery technology, many challenges remain. How can we increase the range, reduce the cost, and extend the lifetime of battery cells? To overcome these challenges, understanding the aging mechanism and making accurate SOH \& RUL predictions of the battery status is crucial. This bachelor thesis investigates the effects of experimental cyclic aging of lithium-ion cells with the cell chemistry of LiFePO4 on the battery capacity and energy. For this purpose, individual cells are aged cyclically, and a series of tests are carried out. The effects of different charge voltages, discharge currents, and depths of discharge on capacity and energy are shown. Approximately five months of data have been collected in addition to previous test measurements from the University's databank, which are used to analyse and develop a new data-driven model that is capable of predicting SOH. This thesis not only contributes to the understanding of battery aging mechanisms specific to LiFePO4 chemistry, but also highlights the potential of the long short-term memory (LSTM) model for SOH prediction in EV battery applications. The developed model's evaluation results show that the proposed model can successfully estimate SOH with higher accuracy. Future research will focus on applying the proposed data-driven model to further improve precision.},
  language  = {en}
}
